# BugChainIndexer cloud config. Copy to .env next to docker-compose.yml.
# Never commit the filled-in copy.

# --- Database ---
PGUSER=postgres
PGPASSWORD=change_me_strong_password

# --- API keys ---
# Etherscan: one key covers all chains (V2 multichain endpoint).
# Free: https://etherscan.io/apis
DEFAULT_ETHERSCAN_KEYS=your_etherscan_key

# --- Telegram alerts ---
# BotFather creates the bot; message it once, then read the chat id via
# getUpdates. Alerts go to this chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Gate tuning ---
PROMOTE_MIN_USD=1000
MAX_DEPLOY_AGE_HOURS=24
GATE_RECHECK_SECONDS=900
GATE_BATCH=500

# --- Chain RPCs ---
# Leave blank to use the defaults baked into scanners/config/networks.js
# (public RPCs). Alchemy keys recommended for ethereum/base/binance.
ETHEREUM_RPC_URL=
BASE_RPC_URL=
BSC_RPC_URL=
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# --- Scanner tuning ---
CONFIRMATIONS=3
DEPLOY_CHUNK=100
